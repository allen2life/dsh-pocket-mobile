{
  "appId": "com.deepseek.dshpocket",
  "appName": "DeepSeek Pocket",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*",
      "http://*",
      "https://*"
    ]
  },
  "plugins": {
    "CapacitorCookies": {
      "enabled": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
